# Personal Learning OS Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Leave empty to use automatic embedded local database)
MONGODB_URI=mongodb://localhost:27017/personal_learning_os

# AI Model Provider (Optional: "gemini", "openai", or empty for built-in rule/heuristic engine)
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

# FSRS 4.5 Configuration
FSRS_REQUEST_RETENTION=0.9
FSRS_MAXIMUM_INTERVAL=36500

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

